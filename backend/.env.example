# FertiFlow AI Environment Configuration Example
DATABASE_URL=sqlite:///./fertiflow.db
# Supabase Postgres Example:
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
GEMINI_API_KEY=your-gemini-api-key-here
SECRET_KEY=fertiflow-super-secret-key-change-in-production-2026
ENVIRONMENT=development

# n8n Workflow Automation Integration (Self-Hosted Docker)
# Set to true when you want FertiFlow to dispatch outbound WhatsApp messages & doctor alerts to n8n
N8N_ENABLED=false
N8N_OUTBOUND_WEBHOOK_URL=http://localhost:5678/webhook/fertiflow-outbound
N8N_DOCTOR_ALERT_WEBHOOK_URL=http://localhost:5678/webhook/fertiflow-doctor-alert
